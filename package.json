{
  "name": "dsh-kylin-automation",
  "version": "0.3.0",
  "description": "DSH \u5b9a\u65f6\u4efb\u52a1\u63d2\u4ef6\uff1a\u628a\u53ef\u590d\u7528\u3001\u53ef\u8fb9\u754c\u5316\u7684\u7f16\u7801\u4efb\u52a1\u6309\u4e00\u6b21\u6027/\u56fa\u5b9a\u95f4\u9694/\u6bcf\u5929/\u6bcf\u5468\u8ba1\u5212\u6295\u9012\u5230\u5168\u65b0\u6839 Agent \u4f1a\u8bdd\u72ec\u7acb\u6267\u884c\uff0cWeb \u4fa7\u8fb9\u680f\u72ec\u7acb\u9875\u9762\u4e0e Agent \u5de5\u5177\u53cc\u5165\u53e3\u7ba1\u7406\uff0c\u8fd0\u884c\u5386\u53f2\u6301\u4e45\u53ef\u5ba1\u8ba1",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "release",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./tests/register-dsh-stubs.mjs --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke-plugin.mjs",
    "prepack": "npm run check && npm run smoke",
    "release:notes": "node scripts/create-github-releases.mjs",
    "sync:mirror": "node scripts/sync-to-dsh-plugins.mjs",
    "sync:check": "node scripts/sync-to-dsh-plugins.mjs --check"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-agent-default-model": "*",
    "@deepseek-ai/dsh-agent-presets": "*",
    "@deepseek-ai/dsh-permission-presets": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "automation",
    "scheduled-task",
    "coding-agent",
    "cordis",
    "kylin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/dsh-kylin-automation.git"
  },
  "publishConfig": {
    "access": "public"
  }
}